# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for Midtrans webhook URL display and self-referential links.
APP_URL="MY_APP_URL"

# Optional initial admin password used only when bootstrapping an empty database
# INITIAL_ADMIN_PASSWORD="change-this-strong-password"

# Optional Midtrans API defaults (can also be configured in Settings > Midtrans API)
# MIDTRANS_MERCHANT_ID=""
# MIDTRANS_CLIENT_KEY=""
# MIDTRANS_SERVER_KEY=""

# Optional SMTP defaults (can also be configured in Settings > Email SMTP)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
